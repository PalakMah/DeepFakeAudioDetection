# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.ipynb_checkpoints/

# ============================================================
# Datasets (never commit raw or processed audio/feature data)
# ============================================================
data/raw/
data/processed/
*.flac
*.wav

